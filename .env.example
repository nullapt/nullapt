# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@localhost:5432/nullapt?sslmode=disable

# Vercel Blob read/write token (from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# GitHub OAuth (https://github.com/settings/applications/new)
# Authorization callback URL must be: https://nullapt.dev/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: port for the registry API (default 8080)
PORT=8080
