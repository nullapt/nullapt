# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@localhost:5432/nullapt?sslmode=disable

# Vercel Blob read/write token (from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# GitHub OAuth (https://github.com/settings/applications/new)
# Authorization callback URL must be: https://nullapt.dev/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: port for the registry API (default 8080)
PORT=8080

# Optional: notify the web app to revalidate skill caches after a successful
# publish. Both must be set; otherwise the registry skips the webhook silently.
# WEB_REVALIDATE_SECRET must match REVALIDATE_SECRET on the web app.
WEB_REVALIDATE_URL=https://nullapt.dev/api/revalidate
WEB_REVALIDATE_SECRET=
