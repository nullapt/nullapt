{
  "schema_version": "1.0",
  "name": "nullapt/web-search",
  "version": "0.1.0",
  "description": "Search the web via DuckDuckGo's Instant Answer API. Returns the abstract plus related-topic links. Network access is restricted to api.duckduckgo.com only.",
  "author": "nullapt",
  "homepage": "https://nullapt.dev/skills/nullapt/web-search",
  "license": "MIT",
  "permissions": {
    "network": {
      "allowed": true,
      "domains": [
        "api.duckduckgo.com"
      ]
    },
    "filesystem": {
      "read": [],
      "write": []
    },
    "env": []
  },
  "entry": "skill.wasm",
  "interface": {
    "tools": [
      {
        "name": "web_search",
        "description": "Search DuckDuckGo and return the abstract plus a short list of related-topic results.",
        "input_schema": {
          "properties": {
            "limit": {
              "description": "Maximum number of related-topic results to return. Default 5.",
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            "query": {
              "description": "The search query.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        }
      }
    ]
  },
  "signature": {
    "algorithm": "ed25519",
    "public_key": "hJGagg8dyUYEGwLDeOGg+3tl+rdxgO7mllWCX6tqwsI=",
    "value": "GOs1YBQ6FPRWCgSj+SvPhZkBCZKH+fO3RNK4w+nXtsPprTjxsr8p3v61wFGo/PR0Ffa9ooCynczvqf8a8EcxBw=="
  }
}
